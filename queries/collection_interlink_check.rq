# archive-etl and findingaid-etl deliberately mint the SAME collection:<id>
# IRI for a given archive (archive-etl's flat MARC catalog record; findingaid-etl's
# full nested EAD component hierarchy for the same archive's top-level record).
# Counts how many collection:<id> IRIs actually have data from both.

PREFIX sdo: <http://schema.org/>

SELECT (COUNT(DISTINCT ?iri) AS ?shared_collection_iris) WHERE {
  GRAPH <https://iisg.amsterdam/graph/archive> { ?iri a sdo:ArchiveComponent }
  GRAPH <https://iisg.amsterdam/graph/findingaid> { ?iri a sdo:ArchiveComponent }
}
